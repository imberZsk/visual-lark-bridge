# 飞书应用在 lark-cli 中的 profile 名称，建议使用独立名称而不是复用其他机器人。
LARK_PROFILE=visual-lark-bridge

# 飞书开放平台中的 App ID，用于安装时停止遗留的事件消费者；App ID 本身不是密钥。
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx

# lark-cli 配置文件路径。通常无需修改，支持使用 $HOME。
LARK_CONFIG_PATH=$HOME/.lark-cli/config.json

# 可选：其他工具确实需要明文密钥时才填写。桥接默认使用 lark-cli Keychain，不读取此值。
LARK_APP_SECRET=
